rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Diagnostics / health check
    match /test/connection {
      allow read: if isSignedIn();
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'theme', 'activeAccountId', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 128 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('theme' in data) || (data.theme in ['dark', 'light', 'blue', 'green', 'purple', 'orange', 'pink'])) &&
        (!('activeAccountId' in data) || (data.activeAccountId is string && data.activeAccountId.size() <= 128)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'icon', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'icon', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
        data.icon is string && data.icon.size() > 0 && data.icon.size() <= 10 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'accountId', 'type', 'amount', 'date', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'accountId', 'type', 'amount', 'details', 'date', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.accountId is string && data.accountId.size() > 0 && data.accountId.size() <= 128 &&
        data.type in ['in', 'out'] &&
        (data.amount is int || data.amount is float) && data.amount > 0 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 200)) &&
        data.date is string && data.date.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTrashItem(data) {
      return data.keys().hasAll(['id', 'userId', 'originalId', 'itemType', 'deletedAt', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'originalId', 'itemType', 'name', 'amount', 'details', 'type', 'accountId', 'date', 'deletedAt', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.originalId is string && data.originalId.size() > 0 && data.originalId.size() <= 128 &&
        data.itemType in ['entry', 'account'] &&
        (!('name' in data) || (data.name is string && data.name.size() <= 60)) &&
        (!('amount' in data) || (data.amount is int || data.amount is float)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 200)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 10)) &&
        (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 128)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 64)) &&
        data.deletedAt is string && data.deletedAt.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'activeAccountId', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Accounts
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(accountId) &&
          isValidAccount(incoming()) &&
          incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(accountId) &&
          isValidAccount(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(accountId);
      }

      // User Entries (Transactions)
      match /entries/{entryId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(entryId) &&
          isValidEntry(incoming()) &&
          incoming().userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(entryId) &&
          isValidEntry(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['accountId', 'type', 'amount', 'details', 'date', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }

      // User Trash (Recycle Bin)
      match /trash/{trashId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(trashId) &&
          isValidTrashItem(incoming()) &&
          incoming().userId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(trashId);
      }
    }
  }
}
